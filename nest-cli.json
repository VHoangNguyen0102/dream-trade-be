{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/",
  "monorepo": true,
  "root": "apps/",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/market/tsconfig.app.json"
  },
  "projects": {
    "market": {
      "type": "application",
      "root": "apps/market",
      "entryFile": "main",
      "sourceRoot": "apps/market",
      "compilerOptions": {
        "tsConfigPath": "apps/market/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "crawler": {
      "type": "application",
      "root": "apps/crawler",
      "entryFile": "main",
      "sourceRoot": "apps/crawler",
      "compilerOptions": {
        "tsConfigPath": "apps/crawler/tsconfig.app.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "ai-analysis": {
      "type": "application",
      "root": "apps/ai-analysis",
      "entryFile": "main",
      "sourceRoot": "apps/ai-analysis/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ai-analysis/tsconfig.app.json"
      }
    },
    "realtime": {
      "type": "application",
      "root": "apps/realtime",
      "entryFile": "main",
      "sourceRoot": "apps/realtime/src",
      "compilerOptions": {
        "tsConfigPath": "apps/realtime/tsconfig.app.json"
      }
    },
    "subscription": {
      "type": "application",
      "root": "apps/subscription",
      "entryFile": "main",
      "sourceRoot": "apps/subscription",
      "compilerOptions": {
        "tsConfigPath": "apps/subscription/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    }
  }
}
