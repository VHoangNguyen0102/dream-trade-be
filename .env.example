# ==========================================
# DREAM TRADE BACKEND - Environment Variables
# ==========================================

# ==========================================
# Database Configuration
# ==========================================

# MongoDB (Main Database)
MONGODB_ENABLED=true
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=AppName
MONGODB_DATABASE=dream_trade_db
MONGODB_DATABASE_CRAWLER=crawl_services

# ==========================================
# Cache & Message Queue
# ==========================================

# Redis
REDIS_URL=redis://localhost:6379
# For Upstash Redis: rediss://default:token@endpoint.upstash.io:6379

# ==========================================
# Authentication
# ==========================================

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Services Configuration
# ==========================================

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000

# Market Service
MARKET_SERVICE_PORT=3001

# Crawler Service
CRAWLER_SERVICE_PORT=3002

# Auth Service
AUTH_SERVICE_PORT=3005

# Subscription Service
SUBSCRIPTION_SERVICE_PORT=3006

# Realtime WebSocket Service
REALTIME_SERVICE_PORT=4000

# ==========================================
# Crawler Settings
# ==========================================

DELAY_BETWEEN_REQUESTS=2
RETRY_ATTEMPTS=3

# ==========================================
# Production Deployment Notes
# ==========================================
# When deploying to production:
# 1. Update all *_URL variables to production URLs
# 2. Use secure Redis (rediss://) with authentication
# 3. Use MongoDB Atlas or managed MongoDB
# 4. Generate strong JWT_SECRET using: openssl rand -base64 32
# 5. Configure proper Google OAuth credentials
# 6. Update FRONTEND_URL to production domain



